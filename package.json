{
  "name": "coding-agent-conventions-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-static-routes.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test:unit && bun run build"
  },
  "dependencies": {
    "marked": "18.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
