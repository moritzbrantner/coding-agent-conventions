{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for repositories adopting the coding-agent conventions.",
  "extends": ["config:best-practices", "schedule:weekly"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 3,
  "automerge": false,
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
